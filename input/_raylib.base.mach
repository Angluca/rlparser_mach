pub val PI: f32 = 3.14159265358979323846;
pub val DEG2RAD: f32 = (PI/180.0f32);
pub val RAD2DEG: f32 = (180.0f32/PI);
pub val LIGHTGRAY: Color = Color{ r: 200, g: 200, b: 200, a: 255 };
pub val GRAY: Color = Color{ r: 130, g: 130, b: 130, a: 255 };
pub val DARKGRAY: Color = Color{ r: 80, g: 80, b: 80, a: 255 };
pub val YELLOW: Color = Color{ r: 253, g: 249, b: 0, a: 255 };
pub val GOLD: Color = Color{ r: 255, g: 203, b: 0, a: 255 };
pub val ORANGE: Color = Color{ r: 255, g: 161, b: 0, a: 255 };
pub val PINK: Color = Color{ r: 255, g: 109, b: 194, a: 255 };
pub val RED: Color = Color{ r: 230, g: 41, b: 55, a: 255 };
pub val MAROON: Color = Color{ r: 190, g: 33, b: 55, a: 255 };
pub val GREEN: Color = Color{ r: 0, g: 228, b: 48, a: 255 };
pub val LIME: Color = Color{ r: 0, g: 158, b: 47, a: 255 };
pub val DARKGREEN: Color = Color{ r: 0, g: 117, b: 44, a: 255 };
pub val SKYBLUE: Color = Color{ r: 102, g: 191, b: 255, a: 255 };
pub val BLUE: Color = Color{ r: 0, g: 121, b: 241, a: 255 };
pub val DARKBLUE: Color = Color{ r: 0, g: 82, b: 172, a: 255 };
pub val PURPLE: Color = Color{ r: 200, g: 122, b: 255, a: 255 };
pub val VIOLET: Color = Color{ r: 135, g: 60, b: 190, a: 255 };
pub val DARKPURPLE: Color = Color{ r: 112, g: 31, b: 126, a: 255 };
pub val BEIGE: Color = Color{ r: 211, g: 176, b: 131, a: 255 };
pub val BROWN: Color = Color{ r: 127, g: 106, b: 79, a: 255 };
pub val DARKBROWN: Color = Color{ r: 76, g: 63, b: 47, a: 255 };
pub val WHITE: Color = Color{ r: 255, g: 255, b: 255, a: 255 };
pub val BLACK: Color = Color{ r: 0, g: 0, b: 0, a: 255 };
pub val BLANK: Color = Color{ r: 0, g: 0, b: 0, a: 0 };
pub val MAGENTA: Color = Color{ r: 255, g: 0, b: 255, a: 255 };
pub val RAYWHITE: Color = Color{ r: 245, g: 245, b: 245, a: 255 };
#[library("raylib")] pub ext rec rAudioBuffer {}
#[library("raylib")] pub ext rec rAudioProcessor {}
pub fun color(r: u8, g: u8, b: u8, a: u8) Color {
    ret Color { r: r, g: g, b: b, a: a };
}
pub fun vector2(x: f32, y: f32) Vector2 {
    ret Vector2 { x: x, y: y };
}
pub fun vector3(x: f32, y: f32, z: f32) Vector3 {
    ret Vector3 { x: x, y: y, z: z };
}
pub fun vector4(x: f32, y: f32, z: f32, w: f32) Vector4 {
    ret Vector4 { x: x, y: y, z: z, w: w };
}
pub fun rectangle(x: f32, y: f32, w: f32, h: f32) Rectangle {
    ret Rectangle { x: x, y: y, width: w, height: h };
}
pub fun logo(x: i32, y: i32, scale: f32) {
    logo_scaled(x::f32, y::f32, scale);
}
fun logo_scaled(x: f32, y: f32, scale: f32) {
    val font: Font = get_font_default();
    val size: f32 = 40.0 * scale;
    val spacing: f32 = size / 10.0;
    draw_text_ex(font, "Mach", Vector2{ x: x, y: y }, size, spacing, ORANGE);
    draw_text_ex(font, "raylib", Vector2{ x: x + 32.0 * scale, y: y + 24.0 * scale }, size, spacing, BLACK);
}
